# Copy to `.env.local` and fill in.

# --- Sanity CMS ---------------------------------------------------------
# NEXT_PUBLIC_ values are exposed to the browser, so they are not secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=6y0e37tr
NEXT_PUBLIC_SANITY_DATASET=production

# --- Spotify Web API ----------------------------------------------------
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_ — that would ship the
# secret to the browser. Create an app at developer.spotify.com/dashboard.
#
# Notes (Feb 2026 API changes):
#  * Development Mode apps require the app OWNER to hold an active Spotify
#    Premium subscription, or the app stops working.
#  * GET /artists/{id}/top-tracks was removed; the site uses Spotify's embed
#    iframe for playback instead.
#  * preview_url is null under Client Credentials.
#
# Both are optional: without them the site falls back to lib/albums.js.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
